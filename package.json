{
  "name": "@ryangarber/better-auth-adapter-prisma",
  "type": "module",
  "version": "0.1.9",
  "description": "Better Auth adapter for Prisma 8 PostgreSQL with codec-preserving additional user fields",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check --write",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "typecheck:contract": "tsc -p tsconfig.contract.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryangarber/better-auth-adapter-prisma.git"
  },
  "keywords": [
    "better-auth",
    "prisma",
    "adapter"
  ],
  "author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@better-auth/core": "^1.7.7",
    "@biomejs/biome": "^2.5.15",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "@prisma/orm-toolchain": "8.0.0-rc.18",
    "@ryangarber/prisma-orm-extension-zod": "^0.2.9",
    "@types/node": "^26.6.4",
    "better-auth": "^1.7.7",
    "temporal-spec": "^1.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "types": "./dist/index.d.mts",
  "peerDependencies": {
    "@better-auth/core": "^1.7.0",
    "@prisma/orm-postgres": "8.0.0-rc.18"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
