{
  "name": "better-auth-prisma-orm",
  "type": "module",
  "version": "0.2.0",
  "description": "A Better Auth adapter for Prisma 8 built with extensions in mind.",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check --write",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.contract.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryangarber/better-auth-adapter-prisma.git"
  },
  "keywords": [
    "better-auth",
    "prisma",
    "adapter"
  ],
  "author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@better-auth/core": "^1.7.18",
    "@biomejs/biome": "^2.6.6",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@prisma/orm-toolchain": "8.0.0-rc.23",
    "prisma-orm-extension-zod": "^0.3.0",
    "@types/node": "^26.6.6",
    "better-auth": "^1.7.18",
    "temporal-spec": "^1.0.1",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "types": "./dist/index.d.mts",
  "peerDependencies": {
    "@better-auth/core": "^1.4.19",
    "@prisma/orm-postgres": "8.0.0-rc.23"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.8"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <27",
      "onFail": "download"
    }
  }
}
