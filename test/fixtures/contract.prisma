// use prisma-8

namespace adapter_test {
  model User {
    id String @id
    email String @unique
    name String
    emailVerified Boolean
    image String?
    createdAt DateTime
    updatedAt DateTime
    profile zod.Json("Profile")
    rich zod.Json("Rich")?
    lastSeen DateTime?
    role String?
    score Int?
    secret String?
    @@map("People")
  }
  model Person {
    id String @id
    emailAddress String @unique
    displayName String
    verified Boolean
    avatar String?
    created DateTime
    updated DateTime
    profileData zod.Json("Profile")
    @@map("CUSTOM_USERS")
  }
  model Session {
    id String @id
    userId String
    token String @unique
    expiresAt DateTime
    createdAt DateTime
    updatedAt DateTime
    ipAddress String?
    userAgent String?
    @@map("login_sessions")
  }
  model Account {
    id String @id
    userId String
    accountId String
    providerId String
    // Required by Better Auth 1.7.0-1.7.2 only; later releases dropped it.
    issuer String?
    accessToken String?
    refreshToken String?
    idToken String?
    accessTokenExpiresAt DateTime?
    refreshTokenExpiresAt DateTime?
    scope String?
    password String?
    createdAt DateTime
    updatedAt DateTime
    @@map("accounts")
  }
  model Verification {
    id String @id
    identifier String
    value String
    expiresAt DateTime
    createdAt DateTime
    updatedAt DateTime
    @@map("verifications")
  }
}
